# platform-gateway process env. Do not commit real values.
# Inbound tokens are in ./config.json; see docs/gateway-auth.example.json.
LISTEN_ADDR=127.0.0.1:8091
# GATEWAY_AUTH_FILE=/absolute/path/config.json  # host process only
# PLATFORM_GATEWAY_AUTH_HOST_FILE=./config.json  # Compose host mount

# Required only if Jira tokens are configured. Choose Bearer OR Basic.
JIRA_BASE_URL=
JIRA_API_TOKEN=
JIRA_BASIC_USER=
JIRA_BASIC_PASSWORD=

# Optional source CIDR allowlist. Empty = allow compose network.
# GATEWAY_ALLOW_CIDRS=

CK_LOGS_BASE_URL=https://ck-logs.icoremail.net
CK_LOGS_BASIC_USER=
CK_LOGS_BASIC_PASS=
CK_LOGS_INDEX=mtatrans_distributed
# Shared by all self-service and analysis routes within one container.
CKLOGS_MAX_CONCURRENCY=2
# Extra waiting requests; 0 rejects immediately when all slots are occupied.
CKLOGS_QUEUE_SIZE=32
# Maximum queue wait, separate from the upstream request timeout.
CKLOGS_QUEUE_WAIT_MS=30000
CK_LOGS_TIMEOUT_MS=60000

GATEWAY_LOG_DIR=./logs
