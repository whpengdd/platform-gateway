# platform-gateway process env. Do not commit real values.
# Token pairing with rag-explorer-ai Runtime still lives in that repo's
# .env.local / install/.env (PLATFORM_GATEWAY_TOKEN must equal GATEWAY_TOKEN_EXTERNAL).

LISTEN_ADDR=127.0.0.1:8091

# External (self-service) and internal (Factory analysis/*) tokens. Must differ.
GATEWAY_TOKEN_EXTERNAL=
GATEWAY_TOKEN_INTERNAL=
# Legacy: used as external-only when the two class vars above are empty.
GATEWAY_AUTH_TOKENS=

# Optional source CIDR allowlist. Empty = allow compose network.
# GATEWAY_ALLOW_CIDRS=

CK_LOGS_BASE_URL=https://ck-logs.icoremail.net
CK_LOGS_BASIC_USER=
CK_LOGS_BASIC_PASS=
CK_LOGS_INDEX=mtatrans_distributed
CKLOGS_MAX_CONCURRENCY=2
CKLOGS_QUEUE_SIZE=32
CKLOGS_QUEUE_WAIT_MS=30000
CK_LOGS_TIMEOUT_MS=60000

GATEWAY_LOG_DIR=./logs
